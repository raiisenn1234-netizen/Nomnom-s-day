<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Surprise ♡</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html,body{
    width:100%;
    min-height:100%;
    font-family:Arial, sans-serif;
    background:#09070d;
    color:white;
    overflow-x:hidden;
}

body{
    background:
      radial-gradient(circle at 20% 20%,#38204d 0%,transparent 30%),
      radial-gradient(circle at 80% 80%,#241d4b 0%,transparent 30%),
      #09070d;
}

.page{
    min-height:100vh;
    display:none;
    align-items:center;
    justify-content:center;
    padding:30px 18px;
    position:relative;
    overflow:hidden;
}

.page.active{
    display:flex;
    animation:fadeIn .7s ease;
}

@keyframes fadeIn{
    from{opacity:0;transform:translateY(20px)}
    to{opacity:1;transform:translateY(0)}
}

.container{
    width:min(900px,100%);
    text-align:center;
    position:relative;
    z-index:2;
}

h1{
    font-size:clamp(34px,8vw,70px);
    margin-bottom:18px;
    letter-spacing:1px;
}

h2{
    font-size:clamp(26px,6vw,48px);
    margin-bottom:16px;
}

p{
    font-size:17px;
    line-height:1.7;
    color:#eee;
}

.small{
    font-size:14px;
    opacity:.75;
}

button{
    border:0;
    padding:14px 25px;
    border-radius:30px;
    background:linear-gradient(135deg,#ff9bd2,#b995ff);
    color:#170c20;
    font-weight:bold;
    cursor:pointer;
    margin-top:25px;
    box-shadow:0 8px 25px #0006;
    transition:.25s;
}

button:hover{
    transform:scale(1.05);
}

.story-card{
    background:#ffffff0d;
    border:1px solid #ffffff20;
    backdrop-filter:blur(12px);
    border-radius:25px;
    padding:28px;
    margin:20px auto;
    max-width:700px;
    box-shadow:0 20px 60px #0006;
}

.story-card h3{
    font-size:25px;
    margin-bottom:10px;
}

/* stars */

.star{
    position:absolute;
    width:3px;
    height:3px;
    background:white;
    border-radius:50%;
    opacity:.7;
    animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
    from{opacity:.2}
    to{opacity:1}
}

/* INTRO */

.intro-title{
    font-size:clamp(40px,10vw,85px);
    background:linear-gradient(90deg,#ff9fd6,#c6a5ff,#fff);
    -webkit-background-clip:text;
    color:transparent;
}

.heart{
    font-size:60px;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    50%{transform:scale(1.15)}
}

/* CHAT */

.chat-box{
    max-width:600px;
    margin:25px auto;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.msg{
    padding:13px 17px;
    border-radius:20px;
    max-width:75%;
    text-align:left;
    background:#ffffff12;
    border:1px solid #ffffff15;
}

.left{
    align-self:flex-start;
    border-bottom-left-radius:4px;
}

.right{
    align-self:flex-end;
    border-bottom-right-radius:4px;
    background:#b46cff30;
}

/* PHOTOS */

.single-photo{
    width:min(500px,100%);
    max-height:550px;
    object-fit:cover;
    border-radius:25px;
    margin:20px auto;
    display:block;
    border:2px solid #ffffff22;
    box-shadow:0 20px 50px #0008;
}

.memory-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
    margin-top:25px;
}

.memory-grid img{
    width:100%;
    height:250px;
    object-fit:cover;
    border-radius:20px;
    border:1px solid #ffffff20;
    box-shadow:0 10px 30px #0006;
    transition:.3s;
}

.memory-grid img:hover{
    transform:scale(1.03) rotate(-1deg);
}

@media(max-width:600px){
    .memory-grid{
        grid-template-columns:1fr;
    }

    .memory-grid img{
        height:320px;
    }
}

/* GIFTS */

.gifts{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-top:30px;
}

.gift{
    background:#ffffff0d;
    padding:18px;
    border-radius:25px;
    border:1px solid #ffffff1c;
    transition:.3s;
}

.gift:hover{
    transform:translateY(-8px);
}

.gift img{
    width:100%;
    height:200px;
    object-fit:cover;
    border-radius:18px;
}

.gift h3{
    margin-top:12px;
}

@media(max-width:650px){
    .gifts{
        grid-template-columns:1fr;
    }
}

/* CAKE */

.cake-area{
    position:relative;
    width:280px;
    height:260px;
    margin:30px auto;
}

.cake{
    position:absolute;
    width:230px;
    height:110px;
    background:linear-gradient(#ffb4d7,#e879ae);
    border-radius:20px 20px 30px 30px;
    bottom:30px;
    left:25px;
    box-shadow:0 15px 35px #0007;
}

.cake:before{
    content:"";
    position:absolute;
    width:230px;
    height:35px;
    background:#fff1f8;
    border-radius:50%;
    top:-12px;
}

.cake:after{
    content:"♡  ♡  ♡";
    position:absolute;
    bottom:20px;
    width:100%;
    text-align:center;
    font-size:22px;
    color:#fff;
}

.candle{
    position:absolute;
    width:18px;
    height:70px;
    background:#fff;
    border-radius:5px;
    left:131px;
    top:70px;
    z-index:3;
}

.flame{
    position:absolute;
    width:25px;
    height:35px;
    background:radial-gradient(circle at 50% 70%,#fff 5%,#ffd45a 30%,#ff6b3d 65%,transparent 70%);
    border-radius:50%;
    left:-4px;
    top:-32px;
    animation:flicker .25s infinite alternate;
}

@keyframes flicker{
    to{transform:scale(1.15) rotate(3deg)}
}

.smoke{
    display:none;
    position:absolute;
    left:125px;
    top:35px;
    font-size:35px;
    opacity:.5;
}

.cake-blown .flame{
    display:none;
}

.cake-blown .smoke{
    display:block;
}

/* LETTER */

.letter-area{
    position:relative;
    width:min(600px,100%);
    height:450px;
    margin:25px auto;
}

.paper{
    position:absolute;
    width:100%;
    height:360px;
    left:0;
    top:40px;
    background:#fff7e8;
    color:#402a22;
    border-radius:5px;
    padding:35px 25px;
    box-shadow:0 20px 50px #0008;
    overflow:hidden;
    transition:.5s;
}

.paper h3{
    color:#8b4168;
    margin-bottom:20px;
}

.hidden-message{
    opacity:0;
    transform:translateY(20px);
    transition:1.2s;
}

.paper.revealed .hidden-message{
    opacity:1;
    transform:translateY(0);
}

.paper.revealed{
    box-shadow:0 0 45px #ffb45d;
}

.burn-overlay{
    position:absolute;
    inset:0;
    pointer-events:none;
    opacity:0;
    background:
      radial-gradient(circle at 20% 30%,#ff7b2f99 0 4%,transparent 8%),
      radial-gradient(circle at 75% 60%,#ff552299 0 5%,transparent 9%),
      radial-gradient(circle at 45% 80%,#ffb34777 0 4%,transparent 8%);
    transition:1s;
}

.paper.burning .burn-overlay{
    opacity:1;
    animation:burn .9s infinite alternate;
}

@keyframes burn{
    from{filter:brightness(1)}
    to{filter:brightness(1.7)}
}

.digital-candle{
    position:absolute;
    width:50px;
    height:80px;
    background:#fff;
    border-radius:10px;
    cursor:grab;
    z-index:10;
    left:20px;
    bottom:0;
    box-shadow:0 10px 25px #0007;
}

.digital-flame{
    position:absolute;
    width:35px;
    height:45px;
    left:7px;
    top:-38px;
    background:radial-gradient(circle,#fff 5%,#ffd34f 35%,#ff6333 65%,transparent 70%);
    animation:flicker .25s infinite alternate;
}

.burn-hint{
    margin-top:10px;
    color:#ddd;
    font-size:14px;
}

/* FINAL */

.final-title{
    font-size:clamp(42px,11vw,95px);
    background:linear-gradient(90deg,#ff9cd9,#fff,#bba3ff);
    -webkit-background-clip:text;
    color:transparent;
    animation:glow 2s infinite alternate;
}

@keyframes glow{
    from{filter:drop-shadow(0 0 5px #ff9cd9)}
    to{filter:drop-shadow(0 0 25px #c9a5ff)}
}

.confetti{
    position:absolute;
    width:8px;
    height:14px;
    animation:fall 4s linear infinite;
}

@keyframes fall{
    from{transform:translateY(-100px) rotate(0)}
    to{transform:translateY(110vh) rotate(720deg)}
}
</style>
</head>

<body>

<!-- ================= INTRO ================= -->

<section class="page active" id="intro">
<div class="container">
    <div class="heart">♡</div>

    <h1 class="intro-title">
        It didn't start normally...
    </h1>

    <p>
        Some friendships start with a simple hello.<br>
        Ours was a little more chaotic.
    </p>

    <button onclick="go('story1')">START THE STORY →</button>
</div>
</section>


<!-- ================= MISUNDERSTANDING ================= -->

<section class="page" id="story1">
<div class="container">

    <h2>Before all this...</h2>

    <div class="story-card">
        <h3>There was a misunderstanding.</h3>

        <p>
            We weren't exactly starting off as besties.
            There were things left unsolved...
        </p>

        <!-- MESSAGE INTENTIONALLY BLANK -->

    </div>

    <button onclick="go('gc')">AND THEN... →</button>
</div>
</section>


<!-- ================= GC ================= -->

<section class="page" id="gc">
<div class="container">

    <h2>Then somehow...</h2>

    <div class="story-card">

        <p>
            I got added to her GC.
        </p>

        <br>

        <p>
            And then came the moment I became an admin...
        </p>

        <div class="chat-box">

            <div class="msg left">
                GC: normal
            </div>

            <div class="msg right">
                Me becoming admin: 💀
            </div>

            <div class="msg left">
                The GC after that:
            </div>

            <div class="msg right">
                CHAOS.
            </div>

        </div>

        <p>
            That GC basically became our adda of chaos.
        </p>

    </div>

    <button onclick="go('admin')">THE CHAOS BEGINS →</button>
</div>
</section>


<!-- ================= ADMIN PHOTO ================= -->

<section class="page" id="admin">
<div class="container">

    <h2>The Admin Era</h2>

    <p>
        This is where everything properly started.
    </p>

    <img
        src="PHOTO_1"
        class="single-photo"
        alt="Admin GC">

    <!-- MESSAGE INTENTIONALLY BLANK -->

    <button onclick="go('reel')">NEXT MEMORY →</button>
</div>
</section>


<!-- ================= FIRST REEL TALK ================= -->

<section class="page" id="reel">
<div class="container">

    <h2>The first proper conversation.</h2>

    <div class="story-card">

        <p>
            After all those unsolved misunderstandings,
            we finally talked again.
        </p>

        <br>

        <p>
            And somehow... it started with a reel.
        </p>

    </div>

    <img
        src="PHOTO_2"
        class="single-photo"
        alt="First conversation">

    <!-- MESSAGE BLANK -->

    <button onclick="go('random')">AND THEN WE KEPT TALKING →</button>
</div>
</section>


<!-- ================= RANDOM ================= -->

<section class="page" id="random">
<div class="container">

    <h2>Randomass conversations.</h2>

    <div class="story-card">

        <p>
            One conversation became another...
        </p>

        <br>

        <p>
            And suddenly we were talking about
            completely randomass things.
        </p>

    </div>

    <img
        src="PHOTO_3"
        class="single-photo"
        alt="Random conversations">

    <!-- MESSAGE BLANK -->

    <button onclick="go('nicknames')">NEXT →</button>
</div>
</section>


<!-- ================= NICKNAMES ================= -->

<section class="page" id="nicknames">
<div class="container">

    <h2>The weird nickname era.</h2>

    <div class="story-card">

        <p>
            Because apparently normal names
            were too boring.
        </p>

        <br>

        <p>
            So we started giving each other
            the most random names possible.
        </p>

    </div>

    <img
        src="PHOTO_4"
        class="single-photo"
        alt="Nicknames">

    <!-- MESSAGE BLANK -->

    <button onclick="go('trolling')">NEXT CHAOS →</button>
</div>
</section>


<!-- ================= TROLLING ================= -->

<section class="page" id="trolling">
<div class="container">

    <h2>Then came the trolling.</h2>

    <div class="story-card">

        <p>
            At some point friendship became:
        </p>

        <br>

        <h3>Who can annoy the other person more?</h3>

    </div>

    <img
        src="PHOTO_5"
        class="single-photo"
        alt="Trolling">

    <!-- MESSAGE BLANK -->

    <button onclick="go('stickers')">WAIT FOR THE FINAL BATTLE →</button>
</div>
</section>


<!-- ================= STICKER WAR ================= -->

<section class="page" id="stickers">
<div class="container">

    <h2>THE ULTIMATE STICKER WAR.</h2>

    <div class="story-card">

        <p>
            And then we discovered the most powerful
            weapon known to friendship...
        </p>

        <br>

        <h3>STICKERS.</h3>

        <p>
            There was no going back.
        </p>

    </div>

    <img
        src="PHOTO_6"
        class="single-photo"
        alt="Ultimate sticker war">

    <!-- MESSAGE BLANK -->

    <button onclick="go('memories')">AND SOMEWHERE IN BETWEEN... →</button>
</div>
</section>


<!-- ================= MEMORIES ================= -->

<section class="page" id="memories">
<div class="container">

    <h2>Somewhere in between...</h2>

    <div class="story-card">

        <p>
            Somewhere between the misunderstandings,
            the GC, random conversations, ridiculous nicknames,
            trolling and sticker wars...
        </p>

        <br>

        <h3>we became friends. ♡</h3>

        <!-- MESSAGE BLANK -->

    </div>

    <div class="memory-grid">

        <img src="PHOTO_1" alt="Memory 1">
        <img src="PHOTO_2" alt="Memory 2">
        <img src="PHOTO_3" alt="Memory 3">
        <img src="PHOTO_4" alt="Memory 4">
        <img src="PHOTO_5" alt="Memory 5">
        <img src="PHOTO_6" alt="Memory 6">

    </div>

    <button onclick="go('gifts')">I GOT YOU SOMETHING →</button>
</div>
</section>


<!-- ================= GIFTS ================= -->

<section class="page" id="gifts">
<div class="container">

    <h2>A little surprise for you...</h2>

    <p>
        Since one gift wasn't enough.
    </p>

    <div class="gifts">

        <div class="gift">
            <img src="PHOTO_GIFT" alt="Gift box">
            <h3>Gift ♡</h3>
            <!-- MESSAGE BLANK -->
        </div>

        <div class="gift">
            <img src="PHOTO_FLOWERS" alt="Flower bouquet">
            <h3>Flowers ♡</h3>
            <!-- MESSAGE BLANK -->
        </div>

        <div class="gift">
            <img src="PHOTO_CHOCOLATE" alt="Chocolate">
            <h3>Chocolate ♡</h3>
            <!-- MESSAGE BLANK -->
        </div>

    </div>

    <button onclick="go('cakeSection')">
        THERE'S MORE →
    </button>
</div>
</section>


<!-- ================= CAKE ================= -->

<section class="page" id="cakeSection">
<div class="container">

    <h2>But first...</h2>

    <p>
        Make a wish. ♡
    </p>

    <div class="cake-area" id="cakeArea">

        <div class="candle">
            <div class="flame"></div>
        </div>

        <div class="smoke">〰️</div>

        <div class="cake"></div>

    </div>

    <button onclick="blowCandle()">
        BLOW OUT THE CANDLE 🕯️
    </button>

    <br>

    <button id="cakeNext"
            style="display:none"
            onclick="go('letterSection')">
        I HAVE ONE LAST THING → 
    </button>

</div>
</section>


<!-- ================= SECRET LETTER ================= -->

<section class="page" id="letterSection">
<div class="container">

    <h2>A secret letter...</h2>

    <p>
        There's something hidden inside.
    </p>

    <div class="letter-area">

        <div class="paper" id="paper">

            <div class="burn-overlay"></div>

            <h3>For you ♡</h3>

            <div class="hidden-message">

                <!-- ================= MESSAGE BLANK ================= -->

                <p>
                    
                </p>

                <!-- ================= MESSAGE BLANK ================= -->

            </div>

        </div>

        <div
            class="digital-candle"
            id="digitalCandle"
            draggable="true">

            <div class="digital-flame"></div>

        </div>

    </div>

    <p class="burn-hint">
        Drag the digital candle over the paper
        and let the flame reveal the message.
    </p>

    <button
        id="letterNext"
        style="display:none"
        onclick="go('final')">
        ONE LAST THING ♡
    </button>

</div>
</section>


<!-- ================= FINAL ================= -->

<section class="page" id="final">
<div class="container">

    <h1 class="final-title">
        HAPPY BIRTHDAY ♡
    </h1>

    <p>
        To someone who somehow turned chaos
        into one of my favourite memories.
    </p>

    <br>

    <!-- MESSAGE BLANK -->

    <p>
        
    </p>

    <button onclick="location.reload()">
        REPLAY THE STORY ↻
    </button>

</div>
</section>


<script>

/* ================= PAGE NAVIGATION ================= */

function go(id){

    document.querySelectorAll(".page").forEach(page=>{
        page.classList.remove("active");
    });

    const next = document.getElementById(id);

    if(next){
        next.classList.add("active");
        window.scrollTo({
            top:0,
            behavior:"smooth"
        });
    }
}


/* ================= STARS ================= */

for(let i=0;i<80;i++){

    const star=document.createElement("div");

    star.className="star";

    star.style.left=Math.random()*100+"%";
    star.style.top=Math.random()*100+"%";

    star.style.animationDelay=
        Math.random()*2+"s";

    document.body.appendChild(star);
}


/* ================= CAKE ================= */

function blowCandle(){

    const cake=document.getElementById("cakeArea");

    cake.classList.add("cake-blown");

    document.getElementById("cakeNext").style.display="inline-block";
}


/* ================= DIGITAL BURNING LETTER ================= */

const candle=
    document.getElementById("digitalCandle");

const paper=
    document.getElementById("paper");


function revealLetter(){

    if(paper.classList.contains("revealed")) return;

    paper.classList.add("burning");

    setTimeout(()=>{

        paper.classList.remove("burning");

        paper.classList.add("revealed");

        candle.style.display="none";

        document.getElementById("letterNext")
            .style.display="inline-block";

    },1500);
}


/* DESKTOP DRAG */

candle.addEventListener("dragstart",function(e){

    e.dataTransfer.setData("text/plain","candle");

});


paper.addEventListener("dragover",function(e){

    e.preventDefault();

});


paper.addEventListener("drop",function(e){

    e.preventDefault();

    revealLetter();

});


/* MOBILE TOUCH DRAG */

let dragging=false;


candle.addEventListener("touchstart",function(e){

    dragging=true;

});


document.addEventListener("touchmove",function(e){

    if(!dragging) return;

    const touch=e.touches[0];

    candle.style.left=
        (touch.clientX-candle.parentElement
        .getBoundingClientRect().left-25)+"px";

    candle.style.top=
        (touch.clientY-candle.parentElement
        .getBoundingClientRect().top-40)+"px";

});


document.addEventListener("touchend",function(e){

    if(!dragging) return;

    dragging=false;

    const c=candle.getBoundingClientRect();
    const p=paper.getBoundingClientRect();

    const overlap=
        c.left<p.right &&
        c.right>p.left &&
        c.top<p.bottom &&
        c.bottom>p.top;

    if(overlap){
        revealLetter();
    }

});


/* ================= CONFETTI FINAL ================= */

function createConfetti(){

    const finalPage=
        document.getElementById("final");

    for(let i=0;i<70;i++){

        const c=
            document.createElement("div");

        c.className="confetti";

        c.innerHTML="✦";

        c.style.left=
            Math.random()*100+"%";

        c.style.top=
            -Math.random()*100+"px";

        c.style.animationDelay=
            Math.random()*3+"s";

        c.style.fontSize=
            (8+Math.random()*12)+"px";

        finalPage.appendChild(c);
    }
}

createConfetti();

</script>

</body>
</html>